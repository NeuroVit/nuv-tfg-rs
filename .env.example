# Backend runtime configuration
NODE_ENV=development
SPRING_PROFILES_ACTIVE=local

# Railway provides PORT automatically in production.
PORT=8080
SERVER_ADDRESS=0.0.0.0
SERVER_FORWARD_HEADERS_STRATEGY=NATIVE

# Preferred single JDBC URL (works for local and Railway)
# Example: jdbc:mysql://localhost:3306/stock_manager
DATABASE_URL=

# Optional split DB values (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_manager
DB_USER=nuv-tfg
DB_PASSWORD=0000

# Use a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_SECURE=true
# Use None in production when frontend/backend are cross-site over HTTPS.
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Google OAuth Client ID used to verify ID tokens
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Optional additional IDs (comma-separated) for other frontend environments
GOOGLE_ALLOWED_CLIENT_IDS=

# Comma-separated list (local + production frontend)
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,tauri://localhost,http://tauri.localhost,https://tauri.localhost,https://web-production-b34f68.up.railway.app

# Optional local AI integration (if infra starts Ollama with --profile ai)
OLLAMA_BASE_URL=http://localhost:11434

# Keep false by default: infra services should be started independently.
# Must stay false in Railway.
SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_DOCKER_COMPOSE_FILE=../nuv-tfg-infra/docker-compose.yml
SPRING_DOCKER_COMPOSE_LIFECYCLE=start-and-stop

# Optional seed control
ANALYTICS_SEED_ENABLED=false

# Keep self role-switch disabled by default.
AUTH_ROLE_SWITCH_ENABLED=false

# Rate limit for /api/auth/login
RATE_LIMIT_AUTH_LOGIN_CAPACITY=10
RATE_LIMIT_AUTH_LOGIN_REFILL_TOKENS=10
RATE_LIMIT_AUTH_LOGIN_REFILL_SECONDS=60

# Rate limit for /api/auth/register
RATE_LIMIT_AUTH_REGISTER_CAPACITY=5
RATE_LIMIT_AUTH_REGISTER_REFILL_TOKENS=5
RATE_LIMIT_AUTH_REGISTER_REFILL_SECONDS=60

# Rate limit for /api/auth/google/verify
RATE_LIMIT_AUTH_GOOGLE_VERIFY_CAPACITY=10
RATE_LIMIT_AUTH_GOOGLE_VERIFY_REFILL_TOKENS=10
RATE_LIMIT_AUTH_GOOGLE_VERIFY_REFILL_SECONDS=60

# Rate limit for /api/auth/refresh
RATE_LIMIT_AUTH_REFRESH_CAPACITY=30
RATE_LIMIT_AUTH_REFRESH_REFILL_TOKENS=30
RATE_LIMIT_AUTH_REFRESH_REFILL_SECONDS=60

# Rate limit for /api/auth/change-password
RATE_LIMIT_AUTH_CHANGE_PASSWORD_CAPACITY=5
RATE_LIMIT_AUTH_CHANGE_PASSWORD_REFILL_TOKENS=5
RATE_LIMIT_AUTH_CHANGE_PASSWORD_REFILL_SECONDS=300

# Rate limit for /api/auth/google/mobile/credential
RATE_LIMIT_AUTH_GOOGLE_MOBILE_CREDENTIAL_CAPACITY=20
RATE_LIMIT_AUTH_GOOGLE_MOBILE_CREDENTIAL_REFILL_TOKENS=20
RATE_LIMIT_AUTH_GOOGLE_MOBILE_CREDENTIAL_REFILL_SECONDS=60
