# Backend runtime configuration (local example)

DB_USER=nuv-tfg
DB_PASSWORD=0000

# Use a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_SECURE=false

# Google OAuth Client ID used to verify ID tokens
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list, e.g. http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limit for /api/auth/login
RATE_LIMIT_AUTH_LOGIN_CAPACITY=10
RATE_LIMIT_AUTH_LOGIN_REFILL_TOKENS=10
RATE_LIMIT_AUTH_LOGIN_REFILL_SECONDS=60

# Rate limit for /api/auth/register
RATE_LIMIT_AUTH_REGISTER_CAPACITY=5
RATE_LIMIT_AUTH_REGISTER_REFILL_TOKENS=5
RATE_LIMIT_AUTH_REGISTER_REFILL_SECONDS=60
